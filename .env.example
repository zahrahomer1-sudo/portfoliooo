# Contact delivery. Leave unset and /api/contact answers 501; the form then
# offers a prefilled mailto instead of pretending the enquiry was sent.

# Option A — post the enquiry as JSON anywhere (Zapier, Make, your own handler).
# CONTACT_WEBHOOK_URL=

# Option B — email via Resend. All three are required together.
# RESEND_API_KEY=
# CONTACT_TO=you@yourdomain.com
# CONTACT_FROM=site@yourdomain.com
